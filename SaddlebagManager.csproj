<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <Author>Solterax</Author>
    <Name>Saddlebag Manager</Name>
    <Punchline>Move items in bulk between your inventory and Chocobo Saddlebag.</Punchline>
    <Description>Deposit or withdraw items in bulk, merge compatible stacks, and optionally include the premium saddlebag.</Description>
    <RepoUrl>https://github.com/Solterax/SaddlebagManager</RepoUrl>
    <Tags>inventory;saddlebag;chocobo</Tags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
